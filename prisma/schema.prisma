generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vinyl {
  id           Int      @id @default(autoincrement())
  artist       String
  album        String
  year         Int
  genre        String
  timesPlayed  Int? @default(0)
  lastPlayed   DateTime?
}